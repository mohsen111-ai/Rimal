# Sahara: Fenix against a published GeckoView (no Gecko compile).
# Artifact mode keeps `./mach configure` light and still gives Gradle its substs.
ac_add_options --enable-project=mobile/android
ac_add_options --enable-artifact-builds
ac_add_options --enable-android-subproject=fenix
ac_add_options --target=aarch64
ac_add_options --with-android-sdk="$HOME/.mozbuild/android-sdk-linux"
mk_add_options MOZ_OBJDIR=./objdir-frontend
